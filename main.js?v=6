	Game.FetchData=function()
	{
		Game.name='Untitled';
		Game.author='anonymous';
		Game.picture='';
		Game.desc='';
		Game.seedText=0;
		Game.again='Generate';
		Game.allUnique=1;
		Game.inIncludes=true;
		Game.genSeed=false;
		
		Game.urlVars=getUrlVars();
		Game.src=Game.urlVars.gen||'';
		Game.seed=replaceAll('+',' ',Game.urlVars.seed||'');
		if (Game.urlVars.amount) Game.amount=Math.max(1,Math.min(50,parseInt(Game.urlVars.amount)))||1;
		if (Game.src=='') {}
		else if (Game.src!='test' && Game.src.indexOf('www.')==-1 && Game.src.indexOf('http://')==-1 && Game.src.indexOf('https://')==-1)
		{
			if (Game.src.indexOf('.txt')==-1) Game.src='https://pastebin.com/raw.php?i='+Game.src;
			//else Game.src='https://orteil.dashnet.org/randomgen/gens/'+Game.src;
			else Game.src='./gens/'+Game.src;
		}
		Game.urlData=Game.urlVars.data||'';
		Game.allRoots=Game.urlVars.allroots?true:false;
		
		if (Game.src!='')
		{
			Game.Reset();
			if (Game.editMode=='url') l('quickGameData').value=decodeURIComponent(Game.urlData);
			Game.inList=0;
			Game.ListNames=[];
			Game.Lists={};
			if (Game.editMode=='url' && Game.urlData!='') Game.UseUrlData();
			else if (Game.editMode=='basic' && l('quickGameData').value.length>0) Game.ParseData(l('quickGameData').value);
			else if (Game.src=='test')
			{
				Game.src='./';
				Game.inIncludes=false;
				Game.ParseData(`
					$name : Test gen
					$author : Orteil
					$description : Just a basic generator to test things out.
					$>flavors
					Your random flavor is [vanilla|strawberry|chocolate|banana]!
					$output
					[Hello|Hey there|Hi|Howdy]! This is a test generator.
				`);
			}
			else Game.FetchGame();
		}
		else
		{
			l('game').className='homeLoaded';
			if (Game.urlVars['do']=='create') l('game').className='createLoaded';
		}
	}
	
	Game.FetchData();
}


